# ─────────────────────────────────────────────
# Banco de Dados (PostgreSQL via Supabase)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# ─────────────────────────────────────────────
# Supabase (Storage de documentos)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─────────────────────────────────────────────
# WhatsApp Cloud API (Meta)
# ─────────────────────────────────────────────
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# ─────────────────────────────────────────────
# n8n Webhook (automações futuras)
# ─────────────────────────────────────────────
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook"
N8N_WEBHOOK_SECRET="your-n8n-secret"

# ─────────────────────────────────────────────
# Anthropic (Claude AI — respostas automáticas WhatsApp)
# ─────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="Energy Service"
